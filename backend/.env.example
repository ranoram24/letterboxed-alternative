# Database
DATABASE_URL=sqlite:///./movie_explorer.db

# Google OAuth (get from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# Session cookie signing
SESSION_SECRET=replace-with-a-long-random-string

# TMDb (get a v3 API key at themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-v3-api-key
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Claude API (get a key at console.anthropic.com) — used server-side only for "What to Choose"
ANTHROPIC_API_KEY=your-anthropic-api-key

# CORS / redirect target after login
FRONTEND_URL=http://localhost:3000
